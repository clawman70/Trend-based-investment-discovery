# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Claude (Anthropic) API key — powers trend analysis, company discovery, news sentiment
# and value-chain summaries (everything except the Research tab). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5

# Google Gemini API key — powers the Research tab's grounded trend scan specifically.
# It runs on Google's own search index, which matters for a task built around finding
# things that happened in the last 30 days. Get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# Optional: override the model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Finnhub API key (free tier works) — live quotes, fundamentals, news, peers and the
# US exchange listing directory used to drop hallucinated tickers. https://finnhub.io/register
FINNHUB_API_KEY=

# Optional: set to "true" to serve clearly-labeled placeholder data when you have no keys.
# Leave unset for real use — without it, missing data shows as "N/A" or an error, never fake values.
# DEMO_MODE=true

# --- Database (persistence for watchlist, portfolios, history, research scans) --------
# Without these, the app still runs — it falls back to an in-memory store that resets
# every time the server restarts. Set both to enable real persistence.
#
# Local dev: run `npm run db:up` (starts Postgres via Docker Compose), then use the
# same connection string for both variables:
POSTGRES_PRISMA_URL=postgresql://trend_discovery:trend_discovery_dev@localhost:5432/trend_discovery?schema=public
POSTGRES_URL_NON_POOLING=postgresql://trend_discovery:trend_discovery_dev@localhost:5432/trend_discovery?schema=public
#
# Production (Vercel Postgres / Neon): use the pooled connection string for
# POSTGRES_PRISMA_URL and the direct (non-pooled) one for POSTGRES_URL_NON_POOLING —
# both are shown in your database provider's dashboard. Then run `npm run db:deploy`
# once to create the tables.

# --- App password (optional access gate) -----------------------------------------------
# Off by default (no friction for local dev). Set APP_PASSWORD to require a login before
# the app (and its API) responds — recommended before deploying anywhere public. Your
# browser will show a native login prompt; enter APP_USERNAME (default "admin") and
# APP_PASSWORD once and it remembers them for the session.
# APP_USERNAME=admin
# APP_PASSWORD=

# --- Daily AI spend cap (safety net, not a hard limit) ----------------------------------
# Shows a warning banner once today's *estimated* Claude + Gemini spend crosses this
# figure — a heads-up against a bug or runaway usage, not real-time billing. AI calls
# keep working as normal past the cap; nothing is blocked. Defaults to $5 if unset.
# DAILY_SPEND_CAP_USD=5
